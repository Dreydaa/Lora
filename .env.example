# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs. / Copy to `.env` (never committed) and fill in.
# Pas d'espace après le « = » / No space after the "=".
# Les mêmes variables (sauf VITE_*) sont à ajouter dans Vercel : Project Settings > Environment Variables.
# The same variables (except VITE_*) go into Vercel: Project Settings > Environment Variables.

# --- App -------------------------------------------------------------------
# URL stable de production (pas l'URL par déploiement, pas localhost). QStash y livre les jobs.
# Stable production URL (not the per-deployment URL, not localhost). QStash delivers jobs there.
APP_URL=https://your-app.vercel.app
# Secret long et aléatoire : déclenchement manuel des crons (Authorization: Bearer ...).
# Long random secret: manual trigger of the crons (Authorization: Bearer ...).
CRON_SECRET=

# --- Groq (https://console.groq.com) ----------------------------------------
GROQ_API_KEY=
# Optionnel / Optional (défaut / default: openai/gpt-oss-120b, repli / fallback: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# --- Notion (https://www.notion.so/profile/integrations) -------------------
NOTION_TOKEN=
# Page parent partagée avec l'intégration ; sert seulement aux scripts `npm run notion:create*`.
# Parent page shared with the integration; only used by the `npm run notion:create*` scripts.
NOTION_PARENT_PAGE_ID=
# Affichés par `npm run notion:create` puis `npm run notion:create-settings`.
# Printed by `npm run notion:create` then `npm run notion:create-settings`.
NOTION_AGENDA_DATABASE_ID=
NOTION_IDEAS_DATABASE_ID=
NOTION_MILESTONES_DATABASE_ID=
NOTION_PROGRESS_DATABASE_ID=
NOTION_SETTINGS_DATABASE_ID=

# --- Telegram (BotFather) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Ton identifiant de chat (nombre) : seul ce chat peut parler à Løra. / Your numeric chat id: the only chat allowed.
TELEGRAM_ALLOWED_CHAT_ID=
# Secret aléatoire, le même que celui donné à setWebhook (secret_token). / Random secret, same as setWebhook's secret_token.
TELEGRAM_WEBHOOK_SECRET=

# --- Upstash QStash (https://console.upstash.com/qstash) --------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# true seulement avec un serveur QStash local ; toujours false en production. / true only with a local QStash server; always false in production.
QSTASH_DEV=false

# --- Upstash Redis (https://console.upstash.com/redis) ----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Dashboard / application de bureau (Tauri) ------------------------------
# Clé partagée entre le serveur (DASHBOARD_API_KEY) et l'app (VITE_*, embarquée dans le build : à tenir secrète).
# Key shared by server (DASHBOARD_API_KEY) and app (VITE_*, baked into the build: keep it secret).
DASHBOARD_API_KEY=
VITE_DASHBOARD_API_KEY=
# Même valeur que APP_URL. / Same value as APP_URL.
VITE_API_URL=https://your-app.vercel.app

# --- Briefing (optionnel / optional) ----------------------------------------
# Coordonnées de la météo (défaut / default: Paris). / Weather coordinates.
WEATHER_LAT=48.8566
WEATHER_LON=2.3522
# Flux RSS des actualités du briefing ; vide = pas d'actualités. / RSS feeds for the briefing news; empty = none.
NEWS_RSS_URL_TECH=
NEWS_RSS_URL_FASHION=
