{
  "name": "lora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --project unit --project integration --project regression",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:regression": "vitest run --project regression",
    "test:acceptance": "vitest run --project acceptance",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:acceptance && npm run test:rust",
    "test:live": "tsx --env-file=.env scripts/full-mechanics-test.ts",
    "test:search": "tsx --env-file=.env scripts/search-battery.ts",
    "test:protocol": "tsx scripts/protocol-e2e.ts",
    "test:projects": "tsx --env-file=.env scripts/projects-battery.ts",
    "notion:check": "tsx --env-file=.env scripts/check-notion-connection.ts",
    "notion:create": "tsx --env-file=.env scripts/create-notion-databases.ts",
    "notion:create-settings": "tsx --env-file=.env scripts/create-settings-database.ts",
    "notion:categories-cleanup": "tsx --env-file=.env scripts/notion-categories-cleanup.ts",
    "notion:migrate-agenda-type": "tsx --env-file=.env scripts/migrate-agenda-type.ts",
    "qstash:setup-schedules": "tsx --env-file=.env scripts/setup-qstash-schedules.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.46",
    "@mediapipe/tasks-vision": "1.2.2",
    "@notionhq/client": "^4.0.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@upstash/qstash": "^2.8.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.109",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.34.0",
    "three": "^0.169.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^5.0.3"
  }
}
